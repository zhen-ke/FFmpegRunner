{
  "id": "extract_audio",
  "name": "提取音频",
  "description": "从视频中提取音频流，支持 MP3/AAC/FLAC/WAV",
  "category": "音频处理",
  "icon": "speaker.wave.2.fill",
  "commandTemplate": "ffmpeg -i {{input}} -vn -c:a {{codec}} {{bitrateArg}} -ac 2 -y {{output}}",
  "parameters": [
    {
      "key": "input",
      "label": "视频文件",
      "type": "file",
      "defaultValue": "",
      "placeholder": "拖入视频",
      "isRequired": true,
      "constraints": {
        "fileTypes": [
          "mp4",
          "mov",
          "mkv",
          "avi",
          "webm",
          "flv"
        ]
      }
    },
    {
      "key": "codec",
      "label": "目标格式",
      "type": "select",
      "defaultValue": "libmp3lame",
      "isRequired": true,
      "constraints": {
        "options": [
          "libmp3lame",
          "aac",
          "flac",
          "pcm_s16le"
        ],
        "optionLabels": [
          "MP3",
          "AAC",
          "FLAC (无损)",
          "WAV (无损)"
        ]
      }
    },
    {
      "key": "bitrateArg",
      "label": "比特率",
      "type": "select",
      "role": "raw",
      "escapeStrategy": "raw",
      "defaultValue": "-b:a 192k",
      "isRequired": true,
      "constraints": {
        "options": [
          "-b:a 128k",
          "-b:a 192k",
          "-b:a 320k"
        ],
        "optionLabels": [
          "128 kbps",
          "192 kbps",
          "320 kbps"
        ]
      },
      "uiHint": {
        "visibleWhen": {
          "key": "codec",
          "operator": "in",
          "values": ["libmp3lame", "aac"]
        }
      }
    },
    {
      "key": "output",
      "label": "输出音频",
      "type": "file",
      "defaultValue": "",
      "placeholder": "保存为 .mp3/.m4a/.flac/.wav",
      "isRequired": true,
      "constraints": {
        "fileTypes": [
          "mp3",
          "m4a",
          "flac",
          "wav"
        ],
        "isOutputFile": true,
        "outputSourceKey": "input",
        "outputExtensionFromKey": "codec",
        "outputExtensionByValue": {
          "libmp3lame": "mp3",
          "aac": "m4a",
          "flac": "flac",
          "pcm_s16le": "wav"
        }
      }
    }
  ]
}

{
  "id": "crop_video",
  "name": "裁剪画面",
  "description": "裁剪视频画面，适用于去黑边或取局部",
  "category": "视频处理",
  "icon": "crop",
  "commandTemplate": "ffmpeg -i {{input}} -vf {{filter}} -c:v libx264 -crf {{crf}} -preset {{preset}} -c:a copy -movflags +faststart -y {{output}}",
  "parameters": [
    {
      "key": "input",
      "label": "输入视频",
      "type": "file",
      "defaultValue": "",
      "placeholder": "选择视频文件",
      "isRequired": true,
      "constraints": {
        "fileTypes": [
          "mp4",
          "mov",
          "avi",
          "mkv",
          "webm",
          "flv",
          "ts",
          "m4v"
        ]
      }
    },
    {
      "key": "filter",
      "label": "裁剪滤镜",
      "type": "string",
      "defaultValue": "crop=1280:720:0:0",
      "isRequired": true,
      "uiHint": {
        "multiline": false,
        "monospace": true,
        "placeholder": "例如 crop=1280:720:0:0 或 crop=in_w:in_h-140:0:70"
      }
    },
    {
      "key": "crf",
      "label": "质量 (CRF)",
      "type": "number",
      "defaultValue": "23",
      "placeholder": "0-51, 数值越小画质越好",
      "isRequired": true,
      "constraints": {
        "min": 0,
        "max": 51
      }
    },
    {
      "key": "preset",
      "label": "编码速度",
      "type": "select",
      "defaultValue": "medium",
      "placeholder": null,
      "isRequired": true,
      "constraints": {
        "options": [
          "ultrafast",
          "superfast",
          "veryfast",
          "faster",
          "fast",
          "medium",
          "slow",
          "slower",
          "veryslow"
        ]
      }
    },
    {
      "key": "output",
      "label": "输出文件",
      "type": "file",
      "defaultValue": "",
      "placeholder": "选择保存位置",
      "isRequired": true,
      "constraints": {
        "fileTypes": [
          "mp4"
        ],
        "isOutputFile": true
      }
    }
  ]
}

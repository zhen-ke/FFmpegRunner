{
  "id": "replace_audio_track",
  "name": "替换音轨",
  "description": "为视频替换新的音轨，保持画面不变",
  "category": "音频处理",
  "icon": "waveform",
  "commandTemplate": "ffmpeg -i {{video}} -i {{audio}} -map 0:v:0 -map 1:a:0 -c:v copy -c:a {{audioCodec}} {{audioBitrateArg}} -shortest -movflags +faststart -y {{output}}",
  "parameters": [
    {
      "key": "video",
      "label": "视频文件",
      "type": "file",
      "defaultValue": "",
      "placeholder": "选择视频文件",
      "isRequired": true,
      "constraints": {
        "fileTypes": [
          "mp4",
          "mov",
          "avi",
          "mkv",
          "webm",
          "flv",
          "ts",
          "m4v"
        ]
      }
    },
    {
      "key": "audio",
      "label": "音频文件",
      "type": "file",
      "defaultValue": "",
      "placeholder": "选择音频文件",
      "isRequired": true,
      "constraints": {
        "fileTypes": [
          "mp3",
          "m4a",
          "aac",
          "flac",
          "wav",
          "ogg",
          "opus"
        ]
      }
    },
    {
      "key": "audioCodec",
      "label": "音频编码",
      "type": "select",
      "defaultValue": "aac",
      "isRequired": true,
      "constraints": {
        "options": [
          "aac",
          "copy"
        ],
        "optionLabels": [
          "AAC (重新编码)",
          "直接复制 (不转码)"
        ]
      }
    },
    {
      "key": "audioBitrateArg",
      "label": "音频码率",
      "type": "select",
      "defaultValue": "-b:a 192k",
      "isRequired": true,
      "constraints": {
        "options": [
          "-b:a 96k",
          "-b:a 128k",
          "-b:a 192k",
          "-b:a 256k",
          "-b:a 320k"
        ],
        "optionLabels": [
          "96 kbps",
          "128 kbps",
          "192 kbps",
          "256 kbps",
          "320 kbps"
        ]
      },
      "uiHint": {
        "visibleWhen": {
          "key": "audioCodec",
          "operator": "notEquals",
          "values": ["copy"]
        }
      }
    },
    {
      "key": "output",
      "label": "输出文件",
      "type": "file",
      "defaultValue": "",
      "placeholder": "选择保存位置",
      "isRequired": true,
      "constraints": {
        "fileTypes": [
          "mp4"
        ],
        "isOutputFile": true
      }
    }
  ]
}

{
  "id": "compress_video_h265",
  "name": "视频压缩 (H.265/HEVC)",
  "description": "使用 H.265/HEVC 编码压缩视频，体积更小，兼容性优化",
  "category": "视频处理",
  "icon": "video.fill",
  "commandTemplate": "ffmpeg -i {{input}} -c:v libx265 -crf {{crf}} -preset {{preset}} -tag:v hvc1 -pix_fmt yuv420p -movflags +faststart -c:a {{audioMode}} {{audioBitrateArg}} -ac 2 -y {{output}}",
  "parameters": [
    {
      "key": "input",
      "label": "输入文件",
      "type": "file",
      "defaultValue": "",
      "placeholder": "选择视频文件",
      "isRequired": true,
      "constraints": {
        "fileTypes": [
          "mp4",
          "mov",
          "avi",
          "mkv",
          "webm",
          "flv",
          "ts",
          "m4v"
        ]
      }
    },
    {
      "key": "crf",
      "label": "质量 (CRF)",
      "type": "number",
      "defaultValue": "28",
      "placeholder": "0-51, 数值越小画质越好",
      "isRequired": true,
      "constraints": {
        "min": 0,
        "max": 51
      }
    },
    {
      "key": "preset",
      "label": "编码速度",
      "type": "select",
      "defaultValue": "medium",
      "placeholder": null,
      "isRequired": true,
      "constraints": {
        "options": [
          "ultrafast",
          "superfast",
          "veryfast",
          "faster",
          "fast",
          "medium",
          "slow",
          "slower",
          "veryslow"
        ]
      }
    },
    {
      "key": "audioMode",
      "label": "音频处理",
      "type": "select",
      "defaultValue": "aac",
      "isRequired": true,
      "constraints": {
        "options": [
          "aac",
          "copy"
        ],
        "optionLabels": [
          "AAC (重新编码)",
          "直接复制 (不转码)"
        ]
      }
    },
    {
      "key": "audioBitrateArg",
      "label": "音频码率",
      "type": "select",
      "defaultValue": "-b:a 128k",
      "isRequired": true,
      "constraints": {
        "options": [
          "-b:a 64k",
          "-b:a 96k",
          "-b:a 128k",
          "-b:a 192k",
          "-b:a 256k",
          "-b:a 320k"
        ],
        "optionLabels": [
          "64 kbps",
          "96 kbps",
          "128 kbps",
          "192 kbps",
          "256 kbps",
          "320 kbps"
        ]
      },
      "uiHint": {
        "visibleWhen": {
          "key": "audioMode",
          "operator": "notEquals",
          "values": ["copy"]
        }
      }
    },
    {
      "key": "output",
      "label": "输出文件",
      "type": "file",
      "defaultValue": "",
      "placeholder": "选择保存位置",
      "isRequired": true,
      "constraints": {
        "fileTypes": [
          "mp4"
        ],
        "isOutputFile": true
      }
    }
  ]
}
